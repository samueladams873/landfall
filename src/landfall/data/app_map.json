{
  "version": 1,
  "notes": "status: same = the same app exists on Linux; alternative = a different app does the same job; wine = only runs through Wine/Proton. Each pattern is a case-insensitive regex matched against the Windows display name.",
  "apps": [
    {"windows": "Google Chrome", "patterns": ["^google chrome"], "status": "same",
     "linux": [{"name": "Google Chrome", "flatpak": "com.google.Chrome"}]},
    {"windows": "Mozilla Firefox", "patterns": ["^mozilla firefox"], "status": "same",
     "linux": [{"name": "Firefox", "flatpak": "org.mozilla.firefox"}]},
    {"windows": "Microsoft Edge", "patterns": ["^microsoft edge$"], "status": "same",
     "linux": [{"name": "Microsoft Edge", "flatpak": "com.microsoft.Edge"}]},
    {"windows": "Brave", "patterns": ["^brave"], "status": "same",
     "linux": [{"name": "Brave", "flatpak": "com.brave.Browser"}]},
    {"windows": "Mozilla Thunderbird", "patterns": ["thunderbird"], "status": "same",
     "linux": [{"name": "Thunderbird", "flatpak": "org.mozilla.Thunderbird"}]},
    {"windows": "Spotify", "patterns": ["^spotify"], "status": "same",
     "linux": [{"name": "Spotify", "flatpak": "com.spotify.Client"}]},
    {"windows": "Discord", "patterns": ["^discord$"], "status": "same",
     "linux": [{"name": "Discord", "flatpak": "com.discordapp.Discord"}]},
    {"windows": "Steam", "patterns": ["^steam$"], "status": "same",
     "linux": [{"name": "Steam (most Windows games run through Proton)", "flatpak": "com.valvesoftware.Steam"}]},
    {"windows": "VLC media player", "patterns": ["^vlc media player"], "status": "same",
     "linux": [{"name": "VLC", "flatpak": "org.videolan.VLC"}]},
    {"windows": "Zoom", "patterns": ["^zoom"], "status": "same",
     "linux": [{"name": "Zoom", "flatpak": "us.zoom.Zoom"}]},
    {"windows": "Slack", "patterns": ["^slack"], "status": "same",
     "linux": [{"name": "Slack", "flatpak": "com.slack.Slack"}]},
    {"windows": "Signal", "patterns": ["^signal"], "status": "same",
     "linux": [{"name": "Signal", "flatpak": "org.signal.Signal"}]},
    {"windows": "Telegram Desktop", "patterns": ["^telegram"], "status": "same",
     "linux": [{"name": "Telegram", "flatpak": "org.telegram.desktop"}]},
    {"windows": "OBS Studio", "patterns": ["^obs studio"], "status": "same",
     "linux": [{"name": "OBS Studio", "flatpak": "com.obsproject.Studio"}]},
    {"windows": "Audacity", "patterns": ["^audacity"], "status": "same",
     "linux": [{"name": "Audacity", "flatpak": "org.audacityteam.Audacity"}]},
    {"windows": "Blender", "patterns": ["^blender"], "status": "same",
     "linux": [{"name": "Blender", "flatpak": "org.blender.Blender"}]},
    {"windows": "GIMP", "patterns": ["^gimp"], "status": "same",
     "linux": [{"name": "GIMP", "flatpak": "org.gimp.GIMP"}]},
    {"windows": "Visual Studio Code", "patterns": ["^microsoft visual studio code"], "status": "same",
     "linux": [{"name": "Visual Studio Code", "flatpak": "com.visualstudio.code"}]},
    {"windows": "Microsoft Office", "patterns": ["^microsoft office", "^microsoft 365"], "status": "alternative",
     "linux": [{"name": "LibreOffice", "flatpak": "org.libreoffice.LibreOffice"},
               {"name": "Office on the web (office.com in your browser)"}]},
    {"windows": "Microsoft OneDrive", "patterns": ["^microsoft onedrive"], "status": "alternative",
     "linux": [{"name": "OneDrive in your browser (onedrive.live.com)"}]},
    {"windows": "Microsoft Teams", "patterns": ["^microsoft teams"], "status": "alternative",
     "linux": [{"name": "Teams in your browser (teams.microsoft.com)"}]},
    {"windows": "Adobe Photoshop", "patterns": ["^adobe photoshop"], "status": "alternative",
     "linux": [{"name": "GIMP", "flatpak": "org.gimp.GIMP"},
               {"name": "Krita", "flatpak": "org.kde.krita"},
               {"name": "PhotoCraft", "url": "https://github.com/storytold/photocraft", "new": true}]},
    {"windows": "Adobe Illustrator", "patterns": ["^adobe illustrator"], "status": "alternative",
     "linux": [{"name": "Inkscape", "flatpak": "org.inkscape.Inkscape"},
               {"name": "VectorCraft", "url": "https://github.com/storytold/vectorcraft", "new": true}]},
    {"windows": "Adobe Premiere Pro", "patterns": ["^adobe premiere"], "status": "alternative",
     "linux": [{"name": "Kdenlive", "flatpak": "org.kde.kdenlive"},
               {"name": "DaVinci Resolve", "url": "https://www.blackmagicdesign.com/products/davinciresolve"},
               {"name": "FilmCraft", "url": "https://github.com/storytold/filmcraft", "new": true}]},
    {"windows": "Adobe Lightroom", "patterns": ["^adobe lightroom"], "status": "alternative",
     "linux": [{"name": "darktable", "flatpak": "org.darktable.Darktable"},
               {"name": "LightCraft", "url": "https://github.com/storytold/lightcraft", "new": true}]},
    {"windows": "Adobe After Effects", "patterns": ["^adobe after effects"], "status": "alternative",
     "linux": [{"name": "Natron", "flatpak": "fr.natron.Natron"},
               {"name": "EffectCraft", "url": "https://github.com/storytold/effectcraft", "new": true}]},
    {"windows": "Adobe InDesign", "patterns": ["^adobe indesign"], "status": "alternative",
     "linux": [{"name": "Scribus", "flatpak": "net.scribus.Scribus"},
               {"name": "DesignCraft", "url": "https://github.com/storytold/designcraft", "new": true}]},
    {"windows": "Adobe Acrobat", "patterns": ["^adobe acrobat"], "status": "alternative",
     "linux": [{"name": "Okular", "flatpak": "org.kde.okular"},
               {"name": "PdfCraft", "url": "https://github.com/storytold/pdfcraft", "new": true}]},
    {"windows": "Notepad++", "patterns": ["^notepad\\+\\+"], "status": "alternative",
     "linux": [{"name": "Kate", "flatpak": "org.kde.kate"}]},
    {"windows": "iTunes", "patterns": ["^itunes$"], "status": "alternative",
     "linux": [{"name": "Rhythmbox", "flatpak": "org.gnome.Rhythmbox3"}]},
    {"windows": "7-Zip", "patterns": ["^7-zip"], "status": "alternative",
     "linux": [{"name": "PeaZip", "flatpak": "io.github.peazip.PeaZip"}]},
    {"windows": "WinRAR", "patterns": ["^winrar"], "status": "alternative",
     "linux": [{"name": "PeaZip", "flatpak": "io.github.peazip.PeaZip"}]},
    {"windows": "KeePass", "patterns": ["^keepass"], "status": "alternative",
     "linux": [{"name": "KeePassXC (opens your KeePass files)", "flatpak": "org.keepassxc.KeePassXC"}]},
    {"windows": "Paint.NET", "patterns": ["^paint\\.net"], "status": "alternative",
     "linux": [{"name": "Pinta", "flatpak": "com.github.PintaProject.Pinta"}]},
    {"windows": "Epic Games Launcher", "patterns": ["^epic games launcher"], "status": "alternative",
     "linux": [{"name": "Heroic Games Launcher", "flatpak": "com.heroicgameslauncher.hgl"}]},
    {"windows": "Battle.net", "patterns": ["^battle\\.net"], "status": "wine",
     "linux": [{"name": "Lutris (runs it through Wine)", "flatpak": "net.lutris.Lutris"}]}
  ]
}
